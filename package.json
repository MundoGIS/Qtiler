{
  "name": "qtiler",
  "version": "3.0.1",
  "description": "Qtiler by MundoGIS – tile cache orchestration for QGIS projects",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "prestart": "node tools/check-runtime.mjs",
    "start": "node server.js",
    "dev": "nodemon --watch . --exec node server.js",
    "build:qtilerauth": "node tools/package-auth-plugin.mjs",
    "build:projectsearch": "node tools/package-projectsearch-plugin.mjs",
    "build:wmscache": "node tools/package-wmscache-plugin.mjs",
    "vendorize:mesh-engine": "node tools/vendorize-mesh-dem-to-terrain.mjs",
    "build:quantizedmesh": "node tools/package-quantizedmesh-plugin.mjs",
    "build:quantizedmesh:full": "npm run vendorize:mesh-engine && npm run build:quantizedmesh",
    "build:vectortiles": "node tools/package-vectortiles-plugin.mjs",
    "build:qrigo": "node tools/package-qrigo-plugin.mjs",
    "build:qtiler2qwc": "node tools/package-Qtiler2qwc-plugin.mjs",
    "build:qtiler2origo": "node tools/package-Qtiler2Origo-plugin.mjs",
    "build:qtiler2hajk": "node tools/package-Qtiler2Hajk-plugin.mjs",
    "build:qtiler3deye": "node tools/package-Qtiler-3D-eye-plugin.mjs",
    "build:qtiler-connector": "node tools/package-qtiler-connector.mjs",
    "build:qtilerstories": "node tools/package-QtilerStories-plugin.mjs",
    "sync:plugins": "node tools/sync-plugin-staging.mjs",
    "build:plugins": "node tools/build-plugins.mjs",
    "terrainforge": "node plugins/QuantizedMesh/terrainforge/cli.mjs",
    "terrainforge:dry": "node plugins/QuantizedMesh/terrainforge/cli.mjs --dry-run",
    "generate:license:ui": "node tools/generate-license-ui.mjs",
    "set:admin-password": "node tools/set-admin-password.mjs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "MundoGIS",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MundoGIS/Qtiler.git"
  },
  "bugs": {
    "url": "https://github.com/MundoGIS/Qtiler/issues"
  },
  "homepage": "https://github.com/MundoGIS/Qtiler/blob/master/README.md",
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "archiver": "7.0.1",
    "bcryptjs": "2.4.3",
    "better-sqlite3": "12.8.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "ejs": "3.1.10",
    "express": "5.1.0",
    "fast-xml-parser": "^5.11.2",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "mssql": "11.0.1",
    "multer": "1.4.5-lts.2",
    "node-windows": "1.0.0-beta.8",
    "ol": "10.8.0",
    "ol-mapbox-style": "13.4.0",
    "pg": "^8.16.3",
    "proj4": "2.20.8",
    "sharp": "^0.35.5",
    "tslib": "^2.8.1",
    "wellknown": "0.5.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "nodemon": "3.1.10"
  },
  "allowScripts": {
    "better-sqlite3@12.8.0": true
  }
}
