
# Qtiler environment configuration example
# NOTE: Supported runtime is QGIS 3.x (Qt5). QGIS 4.x (Qt6) is not supported.

# PUBLIC_BASE_URL=https://your DNS
# WFS
# NOTE: Many clients (QGIS/Origo) request tiles concurrently; huge defaults can cause timeouts.
WFS_DEFAULT_MAX_FEATURES=1000000
WFS_MAX_FEATURES_LIMIT=8000000
QTILER_WMS_MAX_PIXELS=4000000
QTILER_WMS_MAX_LAYERS=20

# Number of Node worker processes (0 = auto = cpu count)
# NOTE: Each Node worker creates its own persistent Python/QGIS pool; keep this modest on Windows.
WORKER_COUNT=3
NODE_OPTIONS=--max-old-space-size=20000

# Number of persistent Python worker processes per Node worker
# NOTE: This is the main knob to prevent tiled WFS holes (queueing -> client timeouts).
PY_WORKER_POOL_SIZE=6

# Per-job timeout (seconds)
WORKER_JOB_TIMEOUT_S=300
JOB_MAX_PER_WORKER=100
WORKER_RESTART_DELAY_S=5
WORKER_MAX_RESTARTS=6
WORKER_RESTART_WINDOW_S=60
WORKER_MAX_MEMORY_MB=20000

# Python + QGIS (QGIS 3.x)
# Set these paths to your local OSGeo4W or standalone QGIS 3.x install.
# Example for standalone: C:\QGIS_3xx\...
PYTHON_EXE=C:\QGIS_3xx\bin\python.exe
OSGEO4W_BIN=C:\QGIS_3xx\bin
# For standalone QGIS installers the actual prefix is typically under apps\qgis.
QGIS_PREFIX=C:\QGIS_3xx\apps\qgis
QT_PLUGIN_PATH=C:\QGIS_3xx\apps\qgis\qtplugins
PYTHONPATH=C:\QGIS_3xx\apps\qgis\python

# Vector Tiles on-demand concurrency (default 3; increase for faster generation)
VECTOR_TILES_MAX_ONDEMAND_WORKERS=6

# Keep QGIS loaded in persistent workers (number of persistent processes, 0 = disabled)
QTILER_PERSISTENT_WORKER=4

NODE_EXE=C:\Program Files\nodejs\node.exe
QTILER_HOME=C:\Qtiler
QUANTIZED_MESH_BUILD_CMD=C:\QGIS_3xx\bin\python.exe C:\Qtiler\tools\mesh_build.py
# Optional: override terrain engine command used by tools/mesh_build.py
# Example if not in PATH: QUANTIZED_MESH_ENGINE_CMD=C:\Tools\mesh-dem-to-terrain\mesh-dem-to-terrain.cmd
QUANTIZED_MESH_ENGINE_CMD=C:\Program Files\nodejs\node.exe C:\Qtiler\tools\mesh_dem_to_terrain_runner.mjs
QUANTIZED_MESH_ENGINE_KIND=mesh-dem-to-terrain
QUANTIZED_MESH_TARGET_CRS=EPSG:4326
# Leave unset to derive contour interval from raster pixel size.
# QUANTIZED_MESH_DXF_CONTOUR_INTERVAL=1
QUANTIZED_MESH_ENGINE_MODULE=C:\Qtiler\ThirdParty\mesh-dem-to-terrain\dist\index.js
QUANTIZED_MESH_JOB_TIMEOUT_MS=0
# Skip caching fully white tiles (helps avoid persistent blank tiles on timeouts)
SKIP_WHITE_TILES=1

# License signing secret (auto-generated on first start if empty or CHANGE_ME)
LICENSE_SECRET=CHANGE_ME

# --- Auth defaults (recommended to set explicitly in production) ---
QTILER_DEFAULT_ADMIN_PASSWORD=MundoGIS-2026
QTILER_AUTH_IDLE_TIMEOUT_SECONDS=1800

# --- HTTP/Service defaults ---
PORT=3000

# --- WFS behavior ---
WFS_MAX_FEATURES_ABSOLUTE_LIMIT=10000000
WFS_CAPABILITIES_DEFAULT_VERSION=2.0.0
WFS_CAPABILITIES_COUNT_DEFAULT=10000
WFS_AUTO_EXPAND_LIMIT=1

# --- VectorTiles worker/on-demand tuning ---
VECTOR_TILES_MAX_CONCURRENT_WORKERS=1
VECTOR_TILES_WORKER_TIMEOUT_MS=1800000
VECTOR_TILES_WORKER_MAX_RETRIES=1
VECTOR_TILES_ONDEMAND_WAIT_SECONDS=12
VECTOR_TILES_QGIS_WAIT_SECONDS=60
VECTOR_TILES_MAX_ONDEMAND_QUEUED=30

# --- Project deletion lock fallback (Windows file locks) ---
PROJECT_LOCK_FALLBACK_COOLDOWN_MS=60000
PROJECT_LOCK_FORCE_KILL=0
LICENSE_SECRET=8d73aafcd86ac3f0e9512e830b537ff7cf4601c93ee099b58bbf49c78070d0bf

