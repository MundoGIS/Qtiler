# Qtiler environment configuration (standalone QGIS)
# Restored after install.bat overwrite. Tune carefully: oversizing
# WORKER_COUNT or PY_WORKER_POOL_SIZE can exhaust system RAM.

# ---------------------------------------------------------------------------
# WFS limits
# NOTE: Many clients (QGIS/Origo) request tiles concurrently; huge defaults can
# cause timeouts.
# ---------------------------------------------------------------------------
WFS_DEFAULT_MAX_FEATURES=100000
WFS_MAX_FEATURES_LIMIT=4000000

# ---------------------------------------------------------------------------
# Node cluster sizing
# NOTE: Each Node worker creates its own persistent Python/QGIS pool.
#       Total RAM ~= WORKER_COUNT * PY_WORKER_POOL_SIZE * (per-QGIS RSS).
#       Keep both modest on Windows to avoid swapping / RAM exhaustion.
# ---------------------------------------------------------------------------
WORKER_COUNT=2
# Cap Node heap. 20 GB is excessive on most machines; 4 GB is plenty for the JS layer.
NODE_OPTIONS=--max-old-space-size=4096

# ---------------------------------------------------------------------------
# Python / QGIS worker pool
# NOTE: Main knob to prevent tiled WFS holes (queueing -> client timeouts).
#       Each pool member loads QGIS into memory (~400-800 MB).
# ---------------------------------------------------------------------------
PY_WORKER_POOL_SIZE=4

# Per-job timeout (seconds)
WORKER_JOB_TIMEOUT_S=300
JOB_MAX_PER_WORKER=100
WORKER_RESTART_DELAY_S=5
WORKER_MAX_RESTARTS=6
WORKER_RESTART_WINDOW_S=60
# Per-worker memory ceiling in MB. Lowered to keep the host stable.
WORKER_MAX_MEMORY_MB=4096

# ---------------------------------------------------------------------------
# Python + QGIS (standalone install)
# ---------------------------------------------------------------------------
PYTHON_EXE=C:\QGIS_344\bin\python.exe
OSGEO4W_BIN=C:\QGIS_344\bin
# For standalone QGIS installers the actual QGIS prefix is under apps\qgis
QGIS_PREFIX=C:\QGIS_344\apps\qgis
# Include qt5 and qt6 plugin folders if present
QT_PLUGIN_PATH=C:\QGIS_344\apps\qgis\qtplugins;C:\QGIS_344\apps\qt5\plugins;C:\QGIS_344\apps\qt6\plugins
PYTHONPATH=C:\QGIS_344\apps\qgis\python

# Keep QGIS loaded in persistent workers
QTILER_PERSISTENT_WORKER=1

# ---------------------------------------------------------------------------
# QuantizedMesh terrain build (used by plugins/QuantizedMesh)
# ---------------------------------------------------------------------------
QUANTIZED_MESH_BUILD_CMD=C:\QGIS_344\bin\python.exe C:\Qtiler\tools\mesh_build.py

# ---------------------------------------------------------------------------
# Service-related paths
# ---------------------------------------------------------------------------
NODE_EXE=C:\Program Files\nodejs\node.exe
QTILER_HOME=C:\Qtiler

# ---------------------------------------------------------------------------
# Licensing secret (do not regenerate; existing licenses are signed with it)
# ---------------------------------------------------------------------------
LICENSE_SECRET=84e947345edea60c21dd251d4ea33c2ffe7c047e41506cca4e89c028a7e66a7f
