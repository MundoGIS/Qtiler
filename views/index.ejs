<%- include('partials/html-open', {
  pageLang,
  pageTitle: 'Qtiler · MundoGIS',
  headScripts: [
    { src: 'https://cdn.jsdelivr.net/npm/proj4@2.9.2/dist/proj4.min.js', crossorigin: 'anonymous' }
  ]
}) %>
    <div class="app-shell">
      <%- include('partials/header', { headerMode: 'dashboard', user, activeNav: activeNav || 'dashboard' }) %>

      <main class="app-main">
        <div id="auth_plugin_notice" class="app-notice app-notice-warning" role="alert" hidden>
          <div class="app-notice-body">
            <div class="app-notice-text">
              <h2 class="app-notice-heading" data-i18n="Authentication plugin unavailable">Authentication plugin unavailable</h2>
              <p data-i18n="You haven't purchased the authentication plugin yet? Contact MundoGIS or visit https://mundogis.se to learn more about this plugin.">You haven't purchased the authentication plugin yet? Contact MundoGIS or visit https://mundogis.se to learn more about this plugin.</p>
              <label class="app-notice-dismiss" for="auth_plugin_notice_dismiss">
                <input id="auth_plugin_notice_dismiss" type="checkbox">
                <span data-i18n="Don't show this again">Don't show this again</span>
              </label>
            </div>
            <div class="app-notice-actions">
              <a id="auth_plugin_notice_learn_more" class="btn btn-outline" href="https://mundogis.se" target="_blank" rel="noopener" data-i18n="Learn more">Learn more</a>
              <button id="auth_plugin_notice_close" class="btn btn-secondary" type="button" data-i18n="Close">Close</button>
            </div>
          </div>
        </div>
        <div class="main-layout">
          <section class="content-panel">
            <div class="project-admin-tabs" role="tablist" aria-label="Project administration">
              <button id="project_upload_tab" class="project-admin-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="project_upload_panel" data-i18n="Projects">Projects</button>
              <button id="project_diagnostics_tab" class="project-admin-tab" type="button" role="tab" aria-selected="false" aria-controls="project_diagnostics_panel" data-i18n="Live diagnostics" hidden>Live diagnostics</button>
            </div>
            <div id="project_upload_panel" class="project-admin-panel" role="tabpanel" aria-labelledby="project_upload_tab">
            <div id="project_upload_toolbar" class="project-upload-card" role="group" aria-label="Project actions">
              <div class="control-actions">
                <button id="upload_project_btn" class="btn btn-primary" data-i18n="Upload project">Upload project</button>
                <input id="project_upload_input" type="file" accept=".qgz,.qgs,.zip" style="display:none" />
                <button id="reload" class="btn btn-secondary" data-i18n="Reload layers">Reload layers</button>
              </div>
              <div class="meta project-upload-hint" data-i18n="Upload bundle hint">If your QGIS project uses file-based layers, upload a .zip that includes exactly one .qgz/.qgs plus the data files, keeping the folder structure.</div>
            </div>

            <div id="project_settings_card" class="project-settings-card" hidden>
              <div class="panel-title" data-i18n="Project settings">Project settings</div>
              <div class="control-grid project-settings-grid">
                <div class="field"><span data-i18n="Min zoom:">Min zoom:</span> <input id="zoom_min" class="input-number" type="number" value="0" data-i18n-placeholder="Min zoom"></div>
                <div class="field"><span data-i18n="Max zoom:">Max zoom:</span> <input id="zoom_max" class="input-number" type="number" value="0" data-i18n-placeholder="Max zoom"></div>
                <div class="field"><span data-i18n="Tile CRS:">Tile CRS:</span>
                  <input id="tile_crs" class="input-text" type="text" placeholder="auto" value="AUTO" disabled data-i18n-placeholder="Tile CRS" />
                </div>
                <div class="field"><label for="published_crs" data-i18n="WMS/WFS CRS:">WMS/WFS CRS:</label>
                  <input id="published_crs" class="input-text" type="text" placeholder="EPSG:3006, EPSG:3857" autocomplete="off" />
                </div>
              </div>
              <div id="project_settings_status" class="meta project-settings-status" aria-live="polite"></div>
            </div>

            <div id="jobs" class="jobs" style="display:none">
              <div class="jobs-heading" data-i18n="Running tasks">Running tasks</div>
              <div id="jobsList" class="list"></div>
            </div>
            <div id="layers" class="list">
              <table>
                <thead>
                  <tr>
                    <th>Layer Name</th>
                    <th>Editable</th>
                    <th>Searchable</th>
                  </tr>
                </thead>
                <tbody id="layersList">
                  <!-- Layers will be dynamically populated here -->
                </tbody>
              </table>
            </div>
            </div>
            <section id="project_diagnostics_panel" class="project-diagnostics-panel" role="tabpanel" aria-labelledby="project_diagnostics_tab" hidden>
              <div class="project-diagnostics-heading">
                <div>
                  <h2 data-i18n="Live diagnostics">Live diagnostics</h2>
                  <p class="meta" data-i18n="Live diagnostics hint">Host resources, QGIS worker queue and recent project errors.</p>
                </div>
                <button id="project_diagnostics_reconnect" class="btn btn-secondary" type="button" data-i18n="Reconnect">Reconnect</button>
              </div>
              <div id="project_diagnostics_connection" class="project-diagnostics-connection meta" aria-live="polite" data-i18n="Waiting for diagnostics">Waiting for diagnostics</div>
              <section class="optimization-panel" aria-labelledby="optimization_heading">
                <div class="optimization-heading">
                  <div>
                    <h3 id="optimization_heading" data-i18n="Server optimization">Server optimization</h3>
                    <p class="meta" data-i18n="Optimization hint">Recommendations use this server’s CPU/RAM and keep a resource reserve.</p>
                  </div>
                  <label class="optimization-profile-field">
                    <span data-i18n="Profile">Profile</span>
                    <select id="optimization_profile">
                      <option value="low" data-i18n="Low">Low</option>
                      <option value="medium" data-i18n="Medium">Medium</option>
                      <option value="aggressive" data-i18n="Aggressive">Aggressive</option>
                    </select>
                  </label>
                </div>
                <div id="optimization_preview" class="optimization-preview meta" aria-live="polite"></div>
                <div class="optimization-actions">
                  <button id="optimization_apply" class="btn btn-primary" type="button" data-i18n="Apply profile">Apply profile</button>
                  <button id="optimization_restart" class="btn btn-secondary" type="button" data-i18n="Restart Windows service" hidden>Restart Windows service</button>
                </div>
                <div id="optimization_status" class="optimization-status meta" aria-live="polite"></div>
              </section>
              <div id="project_diagnostics_metrics" class="project-diagnostics-metrics" aria-live="polite"></div>
              <div id="project_diagnostics_processes" class="project-diagnostics-processes"></div>
              <div id="project_diagnostics_events" class="project-diagnostics-events" role="log" aria-live="off" aria-relevant="additions"></div>
            </section>
          </section>
        </div>
      </main>

      <%- include('partials/footer', { footerClass: 'app-footer', footerYearId: 'footer_year' }) %>
    </div>

   <script src="/js/index.js?v=<%= encodeURIComponent(assetVersion || '') %>" data-qtiler-asset-version="<%= assetVersion || '' %>"></script>
   <script>
     document.addEventListener('DOMContentLoaded', () => {
       const layersList = document.getElementById('layersList');
       if (!layersList) return;
     });
   </script>
<%- include('partials/html-close') %>